@using Sandbox;
@using Sandbox.UI;
@using System;
@using System.Collections.Generic;
@using System.Linq;
@inherits Panel

@* СУВОРО СТАБІЛЬНИЙ DIV БЕЗ @key: Ніколи не створює нових панелей при натисканні ALT *@
<div class="shop-item @(IsMaxed ? "maxed-node" : "") @(IsAddModifierMode ? "no-refund" : "")">

	@* 1. Шапка вузла: Назва та Рівень *@
	<div class="node-header">
		<div class="node-title">@Title</div>

		<div class="node-level-container">
			<div class="node-level">
				@if (!string.IsNullOrEmpty(LevelTextOverride))
				{
					<span>@LevelTextOverride</span>
				}
				else
				{
					@(IsMaxed ? "MAX" : $"LVL {FormatLevel(CurrentLevel)}")
				}
			</div>

			@* Літаючий індикатор змін рівня *@
			@{
				bool isIndicatorActive = (_isBtnHovered && ShouldShowIndicator) || ForceShowFloatingIndicator;
				bool isRefundColor = IsRefundMode; // За замовчуванням
				string indicatorText = "";

				if (!string.IsNullOrEmpty(FloatingIndicatorText))
				{
					indicatorText = FloatingIndicatorText;
					// Якщо кастомний текст починається з мінуса (наприклад, "-1"), фарбуємо в червоний
					isRefundColor = FloatingIndicatorText.StartsWith("-");
				}
				else if (!IsAddModifierMode && (!IsMaxed || IsRefundMode))
				{
					indicatorText = $"{(IsRefundMode ? "-" : "+")}{FormatLevel(Step)}";
				}
			}

			@* Літаючий індикатор змін рівня (Завжди в DOM для плавного плавного вильоту CSS) *@
			<span
				class="lvl-floating-indicator @(isRefundColor ? "refund" : "buy") @(isIndicatorActive ? "active" : "")">
				@indicatorText
			</span>
		</div>
	</div>

	@* 2. Тіло вузла: Динамічний триступеневий тикер прогресії статів *@
	@if (IsRarityUpgrade)
	{
		int prevLvl = Math.Max(1, CurrentLevel - Step);
		int nextLvl = Math.Min(MaxLevel, CurrentLevel + Step);

		<div class="node-progression-ticker @_animClass" @key="@($"{Title}-{CurrentLevel}")">

			<span class="ticker-step previous @(IsRefundMode && CurrentLevel > MinLevel ? "highlight-red" : "")">
				@GetRarityNameByLevel(prevLvl)
			</span>

			<span class="ticker-arrow @(IsRefundMode && CurrentLevel > MinLevel ? "arrow-active-red" : "")">
				➔
			</span>

			<span class="ticker-step current">
				@GetRarityNameByLevel(CurrentLevel)
			</span>

			<span class="ticker-arrow @(!IsRefundMode && CurrentLevel < MaxLevel ? "arrow-active-green" : "")">
				➔
			</span>

			<span class="ticker-step next @(!IsRefundMode && CurrentLevel < MaxLevel ? "highlight-green" : "")">
				@(CurrentLevel >= MaxLevel ? "MAX" : GetRarityNameByLevel(nextLvl))
			</span>

		</div>
	}
	else if (IsAddModifierMode)
	{
		<div class="node-progression-ticker" @key="@($"{Title}-{CurrentLevel}")">
			<span class="ticker-step previous">@(Math.Min(MaxLevel, MaxLevel - CurrentLevel + 1))</span>
			<span class="ticker-arrow">➔</span>
			<span class="ticker-step current">@(MaxLevel - CurrentLevel)</span>
			<span class="ticker-arrow">➔</span>
			<span class="ticker-step next">@(Math.Max(0, MaxLevel - CurrentLevel - 1))</span>
			<span class="ticker-unit">left</span>
		</div>
	}
	else if (Modifiers != null && Modifiers.Count > 0)
	{
		var mod = Modifiers[0];
		var isMult = mod.Multiplier > 0;
		var baseVal = isMult ? mod.Multiplier : mod.Flat;

		// Визначаємо юніт динамічно в залежності від назви або типу стату
		string unit = "pts";
		if (isMult)
		{
			unit = "%";
		}
		else if (Title.Contains("Weight") || Title.Contains("Spawn"))
		{
			unit = "wt"; // Скорочення від Weight (вага)
		}
		else if (mod.Stat == StatType.Damage)
		{
			unit = "dmg";
		}
		else if (mod.Stat == StatType.FireRate || mod.Stat == StatType.TurnSpeed)
		{
			unit = "a/s";
		}

		int prevLvl = Math.Max(0, CurrentLevel - Step);
		int nextLvl = Math.Min(MaxLevel, CurrentLevel + Step);

		var prevVal = baseVal * prevLvl * (isMult ? 100 : 1);
		var currentVal = baseVal * CurrentLevel * (isMult ? 100 : 1);
		var nextVal = baseVal * nextLvl * (isMult ? 100 : 1);

		<div class="node-progression-ticker @_animClass" @key="@($"{Title}-{CurrentLevel}")">

			<span class="ticker-step previous @(IsRefundMode && CurrentLevel > 0 ? "highlight-red" : "")">
				@FormatStat(prevVal)
			</span>

			<span class="ticker-arrow @(IsRefundMode && CurrentLevel > 0 ? "arrow-active-red" : "")">
				➔
			</span>

			<span class="ticker-step current">
				@FormatStat(currentVal)
			</span>

			<span class="ticker-arrow @(!IsRefundMode && !IsMaxed ? "arrow-active-green" : "")">
				➔
			</span>

			<span class="ticker-step next @(!IsRefundMode && !IsMaxed ? "highlight-green" : "")">
				@(IsMaxed && !IsRefundMode ? "MAX" : FormatStat(nextVal))
			</span>

			<span
				class="ticker-unit @(!IsRefundMode && !IsMaxed ? "highlight-green" : "") @(IsRefundMode && CurrentLevel > 0 ? "highlight-red" : "")">
				@unit
			</span>

		</div>
	}

	@* 3. Футер вузла: Вартість та Кнопка дії *@
	<div class="node-action-container">
		<div class="cost-label">
			<div class="cost-title">
				@if (IsRefundMode)
				{
					<span>REFUND -@Step LVL</span>
				}
				else
				{
					<span>COST +@Step LVL</span>
				}
			</div>
			<div class="cost-value @(!CanAfford && !IsRefundMode && !IsMaxed ? "cant-afford" : "")">
				@if (IsMaxed && !IsRefundMode)
				{
					<span>MAXED OUT</span>
				}
				else
				{
					<span class="@(IsRefundMode ? "refund-value" : "")">
						@(IsRefundMode ? "+" : "") $ @FormatMoney(TotalCost)
					</span>
				}
			</div>
		</div>

		@* Кнопка дії: Кліки та наведення обробляються прямо, без умов у розмітці *@
		<div class="@ButtonClass" @onclick="@HandleActionClick"
			 @onmouseover="@(() => { _isBtnHovered = true; OnHoverChanged?.Invoke(true); StateHasChanged(); })"
			 @onmouseout="@(() => { _isBtnHovered = false; OnHoverChanged?.Invoke(false); StateHasChanged(); })">
			@ButtonText
		</div>
	</div>

</div>

@code {
	// --- ПАРАМЕТРИ ДЛЯ ВІДОБРАЖЕННЯ (ДАНІ) ---
	[Parameter] public string Title { get; set; }
	[Parameter] public int CurrentLevel { get; set; }
	[Parameter] public int MaxLevel { get; set; }
	[Parameter] public double BaseCost { get; set; }
	[Parameter] public double CostMultiplier { get; set; }
	[Parameter] public List<StatModifierData> Modifiers { get; set; }

	// --- СТАН ГРАВЦЯ ТА РЕЖИМИ ---
	[Parameter] public double PlayerGold { get; set; }
	[Parameter] public int Multiplier { get; set; }
	[Parameter] public bool IsMaxSelected { get; set; }
	[Parameter] public bool IsRefundMode { get; set; }
	[Parameter] public bool IsRarityUpgrade { get; set; }

	// --- НАШІ НОВІ ПАРАМЕТРИ ---
	[Parameter] public int MinLevel { get; set; }
	[Parameter] public bool IsDisabled { get; set; }
	[Parameter] public string DisabledText { get; set; }
	[Parameter] public bool AllowDeletion { get; set; }

	// --- ДЕЛЕГАТИ ДЛЯ ОБРОБКИ ПОДІЙ ---
	[Parameter] public Action<int, double> OnPurchaseRequested { get; set; }
	[Parameter] public Action<int, double> OnRefundRequested { get; set; }
	[Parameter] public Action OnPurchaseCompleted { get; set; }

	// Додайте ці параметри до списку інших [Parameter]
	[Parameter] public bool IsAddModifierMode { get; set; }
	[Parameter] public string ButtonTextOverride { get; set; }

	[Parameter] public Action<bool> OnHoverChanged { get; set; }
	[Parameter] public string LevelTextOverride { get; set; }

	[Parameter] public string FloatingIndicatorText { get; set; }
	[Parameter] public bool ForceShowFloatingIndicator { get; set; }

	[Parameter] public StatType? TargetStat { get; set; }
	[Parameter] public bool IsCardUpgrade { get; set; }
	// === КОНСТРУКТОР КЛАСУ ДЛЯ БЕЗПЕЧНОГО ЗАДАННЯ ДЕФОЛТНИХ ЗНАЧЕНЬ В S&BOX ===
	public UpgradeNode()
	{
		MaxLevel = 99;
		Multiplier = 1;
		IsMaxSelected = false;
		IsRefundMode = false;
		IsRarityUpgrade = false;
		MinLevel = 0;
		IsDisabled = false;
		DisabledText = "EMPTY";
		AllowDeletion = false;
		IsAddModifierMode = false;
		ButtonTextOverride = "";
	}

	private bool ShouldShowIndicator => IsRefundMode ? (CurrentLevel > MinLevel) : (CanAfford && !IsMaxed);
	private bool _isBtnHovered = false;

	private int _lastLevel = -1;
	private string _animClass = "";

	private bool IsMaxed => CurrentLevel >= MaxLevel;


	private string FormatMoney(double value) => GameMetadata.FormatNumber(value, "0");
	private string FormatLevel(int value) => GameMetadata.FormatNumber(value, "0");
	private string FormatStat(double value) => GameMetadata.FormatNumber(value, "0.#");
	private string GetRarityNameByLevel(int level) => GameMetadata.GetRarityNameByLevel(level);
	// Автоматичний розрахунок Bulk-інформації
	private (double TotalCost, int LevelsCount) BulkInfo
	{
		get
		{
			if (IsDisabled) return (0, 0);

			// === 1. УНІКАЛЬНА ЛОГІКА ДЛЯ ЕВОЛЮЦІЇ РІДКОСТІ ===
			if (IsRarityUpgrade)
			{
				if (IsRefundMode)
				{
					if (CurrentLevel <= MinLevel) return (0, 0);
					double refundVal = Formulas.GetRarityUpgradeCost((UpgradeResource.CardRarity)(CurrentLevel - 2));
					return (refundVal, 1);
				}
				else
				{
					if (CurrentLevel >= MaxLevel) return (0, 0);
					double costVal = Formulas.GetRarityUpgradeCost((UpgradeResource.CardRarity)(CurrentLevel - 1));
					return (costVal, 1);
				}
			}

			// === 2. РОЗРАХУНОК ЦІНИ КАРТКОВИХ СТАТІВ ЧЕРЕЗ ФОРМУЛИ O(1) ===
			if (TargetStat.HasValue && IsCardUpgrade)
			{
				var statType = TargetStat.Value;
				double valuePerLevel = Modifiers != null && Modifiers.Count > 0
					? (Modifiers[0].Multiplier > 0 ? Modifiers[0].Multiplier : Modifiers[0].Flat)
					: 1.0;
				bool isMultiplier = Modifiers != null && Modifiers.Count > 0 && Modifiers[0].Multiplier > 0;

				if (IsRefundMode)
				{
					if (CurrentLevel <= MinLevel && !AllowDeletion) return (0, 0);
					if (CurrentLevel <= 0) return (0, 0);

					int levelsToRefund = 0;
					if (CurrentLevel > MinLevel)
					{
						int maxRefundAllowed = CurrentLevel - MinLevel;
						levelsToRefund = IsMaxSelected ? maxRefundAllowed : Math.Min(Multiplier, maxRefundAllowed);
					}
					else if (CurrentLevel == MinLevel && AllowDeletion)
					{
						levelsToRefund = 1;
					}

					if (levelsToRefund <= 0) return (0, 0);

					double totalRefundValue = Formulas.GetCardStatBulkCost(statType, valuePerLevel, isMultiplier, CurrentLevel -
levelsToRefund, levelsToRefund);
					return (totalRefundValue, levelsToRefund);
				}
				else
				{
					if (CurrentLevel >= MaxLevel) return (0, 0);

					int levelsLimit = IsMaxSelected ? (MaxLevel - CurrentLevel) : Math.Min(Multiplier, MaxLevel - CurrentLevel);
					int actualCount = 0;

					if (IsMaxSelected)
					{
						actualCount = Formulas.GetCardStatAffordableLevels(statType, valuePerLevel, isMultiplier, CurrentLevel, PlayerGold);
						actualCount = Math.Min(levelsLimit, actualCount);
						if (actualCount <= 0) actualCount = 1;
					}
					else
					{
						actualCount = levelsLimit;
					}

					double totalCost = Formulas.GetCardStatBulkCost(statType, valuePerLevel, isMultiplier, CurrentLevel, actualCount);
					return (totalCost, actualCount);
				}
			}

			// === 3. НОВИЙ ШЛЯХ: РОЗРАХУНОК ЦІНИ МАГАЗИНУ ВЕЖІ ЧЕРЕЗ ФОРМУЛИ O(1) ===
			if (TargetStat.HasValue && !IsCardUpgrade)
			{
				var statType = TargetStat.Value;

				if (IsRefundMode)
				{
					if (CurrentLevel <= MinLevel && !AllowDeletion) return (0, 0);
					if (CurrentLevel <= 0) return (0, 0);

					int levelsToRefund = 0;
					if (CurrentLevel > MinLevel)
					{
						int maxRefundAllowed = CurrentLevel - MinLevel;
						levelsToRefund = IsMaxSelected ? maxRefundAllowed : Math.Min(Multiplier, maxRefundAllowed);
					}
					else if (CurrentLevel == MinLevel && AllowDeletion)
					{
						levelsToRefund = 1;
					}

					if (levelsToRefund <= 0) return (0, 0);

					// Розраховуємо рефунд магазину через GetShopStatBulkCost
					double totalRefundValue = Formulas.GetShopStatBulkCost(statType, CurrentLevel - levelsToRefund, levelsToRefund);
					return (totalRefundValue, levelsToRefund);
				}
				else
				{
					if (CurrentLevel >= MaxLevel) return (0, 0);

					int levelsLimit = IsMaxSelected ? (MaxLevel - CurrentLevel) : Math.Min(Multiplier, MaxLevel - CurrentLevel);
					int actualCount = 0;

					if (IsMaxSelected)
					{
						// Розраховуємо доступні рівні для магазину через GetShopStatAffordableLevels
						actualCount = Formulas.GetShopStatAffordableLevels(statType, CurrentLevel, PlayerGold);
						actualCount = Math.Min(levelsLimit, actualCount);
						if (actualCount <= 0) actualCount = 1;
					}
					else
					{
						actualCount = levelsLimit;
					}

					// Розраховуємо покупку магазину через GetShopStatBulkCost
					double totalCost = Formulas.GetShopStatBulkCost(statType, CurrentLevel, actualCount);
					return (totalCost, actualCount);
				}
			}

			// === 4. ДЕФОЛТНИЙ ШЛЯХ: ЗВИЧАЙНИЙ ГЕОМЕТРИЧНИЙ РОЗРАХУНОК (Резервний) ===
			if (IsRefundMode)
			{
				if (CurrentLevel <= MinLevel && !AllowDeletion) return (0, 0);
				if (CurrentLevel <= 0) return (0, 0);

				int levelsToRefund = 0;

				if (CurrentLevel > MinLevel)
				{
					int maxRefundAllowed = CurrentLevel - MinLevel;
					levelsToRefund = IsMaxSelected ? maxRefundAllowed : Math.Min(Multiplier, maxRefundAllowed);
				}
				else if (CurrentLevel == MinLevel && AllowDeletion)
				{
					levelsToRefund = 1;
				}

				if (levelsToRefund <= 0) return (0, 0);

				double totalRefundValue = Formulas.GetBulkCost(BaseCost, CostMultiplier, CurrentLevel - levelsToRefund, levelsToRefund);
				return (totalRefundValue, levelsToRefund);
			}
			else
			{
				if (CurrentLevel >= MaxLevel) return (0, 0);

				int levelsLimit = IsMaxSelected ? (MaxLevel - CurrentLevel) : Math.Min(Multiplier, MaxLevel - CurrentLevel);

				int actualCount = 0;
				if (IsMaxSelected)
				{
					int affordable = Formulas.GetAffordableLevels(BaseCost, CostMultiplier, CurrentLevel, PlayerGold);
					actualCount = Math.Min(levelsLimit, affordable);
					if (actualCount <= 0)
					{
						actualCount = 1;
					}
				}
				else
				{
					actualCount = levelsLimit;
				}

				double totalCost = Formulas.GetBulkCost(BaseCost, CostMultiplier, CurrentLevel, actualCount);
				return (totalCost, actualCount);
			}
		}
	}

	private double TotalCost => BulkInfo.TotalCost;
	private int Step => BulkInfo.LevelsCount <= 0 ? 1 : BulkInfo.LevelsCount;
	private bool CanAfford => PlayerGold >= TotalCost;

	private bool IsRefundEmpty => IsRefundMode && (CurrentLevel <= 0 || (CurrentLevel <= MinLevel && !AllowDeletion));

	private string ButtonText
	{
		get
		{
			if (!string.IsNullOrEmpty(ButtonTextOverride)) return ButtonTextOverride;
			if (IsMaxed && !IsRefundMode) return "MAXED";
			if (IsDisabled) return DisabledText;
			if (IsRefundMode) return IsRefundEmpty ? "EMPTY" : "RETURN";
			return CanAfford ? "BUY" : "NO CASH";
		}
	}

	private string ButtonClass
	{
		get
		{
			string baseClass = "";

			if (!string.IsNullOrEmpty(ButtonTextOverride) && ButtonTextOverride == "CLOSE")
			{
				baseClass = "quick-buy-btn return-action";
			}
			else if (IsMaxed && !IsRefundMode)
			{
				baseClass = "btn-maxed empty";
			}
			else if (IsDisabled)
			{
				baseClass = "btn-maxed empty";
				if (DisabledText == "SLOTS BUSY") baseClass += " slots-busy";
			}
			else if (IsRefundMode)
			{
				baseClass = IsRefundEmpty ? "btn-maxed empty" : "quick-buy-btn return-action";
			}
			else
			{
				baseClass = CanAfford ? "quick-buy-btn buy-action" : "quick-buy-btn can-not-afford";
			}

			return $"{baseClass} state-level-{CurrentLevel}";
		}
	}

	protected override void OnParametersSet()
	{
		int level = CurrentLevel;
		if (_lastLevel != -1)
		{
			if (level > _lastLevel) _animClass = "animate-buy";
			else if (level < _lastLevel) _animClass = "animate-refund";
			else _animClass = "";
		}
		_lastLevel = level;

		// ФІКС S&box: примусово перераховуємо CSS-селектори,
		// щоб скинути закешовані !important-правила при зміні стану
		StyleSelectorsChanged(true, false, null);
	}

	private void HandleActionClick()
	{
		if (IsAddModifierMode)
		{
			OnPurchaseRequested?.Invoke(0, 0);
			return;
		}

		// === ЗАПОБІЖНИК: Блокуємо клік в C#, якщо нода заблокована ===
		bool isInteractionDisabled = (IsMaxed && !IsRefundMode) || IsRefundEmpty || (IsRarityUpgrade && IsDisabled);
		if (isInteractionDisabled) return;

		var bulk = BulkInfo;
		if (bulk.LevelsCount <= 0) return;

		if (IsRefundMode)
		{
			OnRefundRequested?.Invoke(bulk.LevelsCount, bulk.TotalCost);
		}
		else
		{
			OnPurchaseRequested?.Invoke(bulk.LevelsCount, bulk.TotalCost);
		}

		OnPurchaseCompleted?.Invoke();
		StateHasChanged();
	}

}