@using Sandbox;
@using Sandbox.UI;
@using System;
@using System.Linq;
@using UI.Shop.ShopPanels
@inherits PanelComponent

@if (IsShopOpen)
{
	@* Вішаємо клас alt-held автоматично, якщо увімкнено режим повернення *@
	<div class="shop-window @(IsActiveRefundMode ? "alt-held" : "")">

		@* ГЛОБАЛЬНА ШАПКА *@
		<div class="shop-global-header">

			@* ТАБИ НАВІГАЦІЇ (Тепер включають заголовок та кнопку в одному потоці) *@
			<div class="shop-tabs" style="display: flex; flex-direction: row; align-items: center;">

				@* ЛІВИЙ БЛОК: Опущений нижче та вирівняний з табами *@
				<div
					style="display: flex; flex-direction: row; align-items: center; gap: 16px; margin-right: 32px; margin-bottom: 4px; margin-top: 6px; flex-shrink: 0; align-self: center;">

					@* Чистий заголовок з гарантованим світінням *@
					<div class="alpha-title">
						ALPHA
						<div class="version-wrapper">
							<div class="ambient-glow"></div>
							<span class="version-rainbow">v0.1</span>
						</div>
					</div>

					@* Тонкий сірий розділювач *@
					<div style="width: 1px; height: 16px; background-color: rgba(255, 255, 255, 0.08); flex-shrink: 0;">
					</div>

					@* Кнопка виходу (збільшена) *@
					<div class="btn-reenter-loop" @onclick="@ReenterLoop"
						 style="white-space: nowrap; padding: 8px 18px; font-size: 10px; letter-spacing: 1.5px; border-color: rgba(0, 255, 204, 0.3); background-color: rgba(0, 255, 204, 0.02); margin: 0; box-shadow: 0 0 10px rgba(0, 255, 204, 0.05);">
						RE-ENTER LOOP ⚔️
					</div>
				</div>

				@* САМІ ТАБИ *@
				@foreach (ShopTab tab in GetActiveSceneTabs())
				{
					var isActive = HasActiveTab && ActiveTab == tab;
					<div class="tab @(isActive ? "active" : "")" @onclick="@(() => SelectTab(tab))">
						@GameMetadata.GetTabFriendlyName(tab)
					</div>
				}
			</div>

			@* БЛОК РЕЖИМІВ ТА МНОЖНИКІВ *@
			<div class="shop-right-widgets">

				@* Перемикач режимів BUY / RETURN *@
				<div class="shop-mode-selector">
					<div class="bulk-option buy-option @(!IsActiveRefundMode ? "active" : "")"
						 @onclick="@(() => ManualRefundMode = false)">
						BUY
					</div>
					<div class="bulk-option return-option @(IsActiveRefundMode ? "active" : "")"
						 @onclick="@(() => ManualRefundMode = true)">
						RETURN
					</div>
				</div>

				@* Множники x1, x10, x100, Max *@
				<div class="bulk-buy-selector">
					@foreach (var count in new[] { 1, 10, 100 })
					{
						<div class="bulk-option @(SelectedMultiplier == count ? "active" : "")"
							 @onclick="@(() => SetMultiplier(count))">
							<span class="x-prefix">x</span>@(count)
						</div>
					}
					<div class="bulk-option @(IsMaxSelected ? "active" : "")" @onclick="@SetMaxMultiplier">
						MAX
					</div>
				</div>
			</div>
		</div>

		@* ВІДОБРАЖЕННЯ АКТИВНОЇ БІЧНОЇ ПАНЕЛІ (Передаємо параметри) *@
		@if (HasActiveTab)
		{
			@switch (ActiveTab)
			{
				case ShopTab.Cards:
					@* Додаємо клас "cards-tab-panel" тільки для цієї вкладки *@
					<div class="shop-side-panel left cards-tab-panel">
						<ShopCardsPanel Multiplier="@SelectedMultiplier" IsMaxSelected="@IsMaxSelected"
										IsRefundMode="@IsActiveRefundMode" />
					</div>
					break;

				case ShopTab.Tower:
					<div class="shop-side-panel right">
						@* Передаємо множники та режим ALT безпосередньо в панель *@
						<ShopTowerPanel Multiplier="@SelectedMultiplier" IsMaxSelected="@IsMaxSelected"
										IsRefundMode="@IsActiveRefundMode" />
					</div>
					break;
				case ShopTab.Game:
					<div class="shop-side-panel right">
						<div style="color: #8c8895; font-size: 12px; margin: auto; text-transform: uppercase; letter-spacing: 1px;">
							IN DEVELOPMENT
						</div>
					</div>
					break;
				default:
					<div class="shop-side-panel left">
						<div style="color: #8c8895; font-size: 12px; margin: auto; text-transform: uppercase; letter-spacing: 1px;">
							IN DEVELOPMENT
						</div>
					</div>
					break;
			}
		}
		else
		{
			<div
				style="display: flex; flex-direction: column; align-items: center; justify-content: center; margin: auto; text-align: center; pointer-events: all;">
				<div style="font-size: 24px; color: rgba(255, 255, 255, 0.03); margin-bottom: 8px;">🖥️</div>
				<div style="font-size: 11px; font-weight: 900; color: #ffffff; text-transform: uppercase; letter-spacing: 1px;">

				</div>
				<div
					style="font-size: 9px; color: #8c8895; max-width: 250px; margin-top: 4px; line-height: 1.4; text-transform: uppercase; letter-spacing: 0.5px;">

				</div>
			</div>
		}

	</div>
}

@code {
	public int SelectedMultiplier { get; private set; } = 1;
	public bool IsMaxSelected { get; private set; } = false;

	// Логіка ручного перемикання режиму повернення
	public bool ManualRefundMode { get; private set; } = false;

	private bool IsShopOpen => GameManager.Instance != null && GameManager.Instance.CurrentState == GameState.Shopping;

	private CameraControlComponent Camera => _camera ??= Scene.GetAllComponents<CameraControlComponent>().FirstOrDefault();
	private CameraControlComponent _camera;
	private bool _wasShopOpen = false;


	private bool HasActiveTab => Camera != null && Camera.HasActiveTab;
	private ShopTab ActiveTab => Camera != null ? Camera.ActiveTab : ShopTab.Tower;

	// Гарантоване натискання Alt (кнопка Walk)
	private bool IsAltHeld => Input.Down("Walk");

	// Режим повернення активний, якщо затиснуто ALT АБО якщо його ввімкнули вручну через кнопку
	private bool IsActiveRefundMode => ManualRefundMode ^ IsAltHeld;


	protected override void OnUpdate()
	{
		bool currentlyOpen = IsShopOpen;
		if (currentlyOpen && !_wasShopOpen)
		{
			// Магазин щойно відкрився — примусово ставимо режим BUY
			ManualRefundMode = false;
		}
		_wasShopOpen = currentlyOpen;

		StateHasChanged();
	}

	private void SetMultiplier(int value)
	{
		SelectedMultiplier = value;
		IsMaxSelected = false;
		StateHasChanged();
	}

	private void SetMaxMultiplier()
	{
		IsMaxSelected = true;
		SelectedMultiplier = -1;
		StateHasChanged();
	}

	private void SelectTab(ShopTab tab)
	{
		if (Camera == null) return;

		if (HasActiveTab && ActiveTab == tab)
		{
			Camera.FocusOnCategory(tab, null);
			return;
		}

		var shopObject = Scene.GetAllComponents<InteractableShopObject>()
							 .FirstOrDefault(x => x.AssociatedTab == tab);

		if (shopObject != null)
		{
			Camera.FocusOnCategory(
				tab,
				shopObject.CameraFocusAnchor,
				shopObject.SpeedOverride
			);
		}
		else
		{
			Camera.FocusOnCategory(tab, null);
		}
	}

	// 4. Оновіть метод ReenterLoop(), щоб при виході також скидався режим:
	private void ReenterLoop()
	{
		if (Camera != null)
		{
			Camera.FocusOnCategory(ActiveTab, null);
		}
		ManualRefundMode = false; // Скидаємо у BUY для наступного разу

		if (GameManager.Instance != null)
		{
			GameManager.Instance.StartRun();
		}

		Log.Info("[Loop] Re-entering the Time Loop.");
	}
	private List<ShopTab> GetActiveSceneTabs()
	{
		if (Scene == null) return new();

		return Scene.GetAllComponents<InteractableShopObject>()
							.Select(x => x.AssociatedTab)
							.Distinct()
							.ToList();
	}

	protected override int BuildHash()
	{
		var camHash = Camera != null
			? HashCode.Combine(HasActiveTab, ActiveTab)
			: 0;

		return HashCode.Combine(camHash, SelectedMultiplier, IsMaxSelected, IsAltHeld, ManualRefundMode, IsShopOpen);
	}
}